{
  // Note: when running "Update NeoCade Theme subtree", make sure no files
  // under `addons/neocade_theme/` are open with unsaved buffers in your
  // editor. A stale IDE buffer can auto-save its older content over the
  // freshly-pulled file, leaving the working tree dirty and causing
  // `git subtree pull` to fail next time with "Cannot add". The
  // pre-flight check below catches that and prints a clear actionable
  // message. The check lives in `.vscode/check_subtree_clean.ps1` so it
  // avoids the quoting-hell inherent to inline pwsh -Command in VSCode
  // tasks.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "_check-subtree-clean",
      "detail": "Pre-flight: aborts if addons/neocade_theme has uncommitted changes (usually a stale IDE buffer).",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/.vscode/check_subtree_clean.ps1"
      ],
      "presentation": { "reveal": "silent", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "Update NeoCade Theme subtree",
      "type": "shell",
      "command": "git",
      "args": [
        "subtree",
        "pull",
        "--prefix=addons/neocade_theme",
        "https://github.com/Shilo/NeoCade-Theme.git",
        "addon",
        "--squash"
      ],
      "dependsOn": "_check-subtree-clean",
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    }
  ]
}
